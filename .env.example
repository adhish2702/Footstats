# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Database the pipeline writes to and the API reads from.
# Local:  postgresql://footstats:<password>@localhost:5432/footstats
# Neon:   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://footstats:change-me@localhost:5432/footstats

# Separate database for the tests (it is wiped and re-seeded on every run).
# Its name must contain "test"; the API tests refuse to reset anything else.
TEST_DATABASE_URL=postgresql://footstats:change-me@localhost:5432/footstats_test

# API (Express). Port to listen on, and the front-end origins allowed by CORS
# (comma-separated). In production, set CORS_ORIGIN to the deployed front end only.
PORT=4000
CORS_ORIGIN=http://localhost:5173
